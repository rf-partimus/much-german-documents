<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_din5008_much"
              inherit_id="l10n_din5008.external_layout_din5008">
        <xpath expr="//div/div[contains(@t-attf-class, 'header')]" position="before">
            <t t-set="main_company" t-value="env.company"/>
            <t t-if="o and 'company_id' in o._fields and o.company_id" t-set="main_company" t-value="o.company_id"/>
            <t t-set="primary" t-value="main_company.report_primary_color or '#ea5747'"/>
            <t t-set="secondary" t-value="main_company.report_secondary_color or '#ffffff'"/>
            <t t-set="report_name"
               t-value="env['ir.actions.report'].search([('report_name', '=', xmlid)]).report_name"/>
            <style>
                .company_tagline p{
                margin: 0px !important;
                }
                .din_page.invoice_note .page [name=invoice_line_table] th,
                .din_page.invoice_note .page [name=stock_move_table] th,
                .din_page.invoice_note .page .o_main_table th {
                color:
                <t t-out='secondary'/>
                !important;
                background:
                <t t-out='primary'/>
                !important;
                }
                /* 2026: styles here reach only the body html — header/footer html need inline styles */
                /* 2026: zero-margin paperformat ⇒ body gets DIN margins via padding */
                .din_page.invoice_note {
                padding-left: 20mm !important;
                padding-right: 10mm !important;
                }
                /* Sender line on one line */
                .din_company_info .address {
                white-space: nowrap;
                }
                /* Table row bottom borders */
                [name=invoice_line_table] tbody td {
                border-bottom: 0.5pt solid #E5E5E5 !important;
                }
            </style>
        </xpath>
        <xpath expr="//table[hasclass('din_company_info', 'table-borderless')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!--   Header   Part: 2026 design — single full-width image (gradient bar + logo).
             Zero-margin paperformat: viewport = 210mm ⇒ wkhtmltopdf shrink-to-fit scale = 1 -->
        <xpath expr="//table[hasclass('company_header', 'table-borderless')]" position="replace">
            <img src="/much_qweb_updater/static/img/header_full_2026.png" alt="partimus – host local. share global."
                 style="width: 210mm; height: 25.4mm; margin: 0; display: block; padding: 0; float: none;"/>
        </xpath>
        <xpath expr="//h2" position="attributes">
            <attribute name="t-if">not skip_headers and report_name not in ['account.report_invoice',
                'account.report_invoice_with_payments', 'stock.report_deliveryslip',
                'purchase.report_purchaseorder',
                'purchase_requisition.report_purchaserequisitions',
                'purchase.report_purchasequotation',
                'sale.report_saleorder',
                'sale.report_saleorder_pro_forma']
            </attribute>
        </xpath>
        <xpath expr="//table[hasclass('din_company_info', 'table-borderless')]" position="after">
            <div class="row din_company_info">
                <t t-set="company_data"
                   t-value="(main_company.name or '') + (main_company.street or '') + (main_company.street2 or '')  + (company.zip or '')"/>
                <t t-set="company_data" t-value="company_data + company.country_id.name"
                   t-if="company_data and main_company.print_company"/>
                <t t-set="one_line_data" t-value="True if len(company_data) &lt; 90 else False" t-if="company_data"/>
                <div class="col-12" t-att-style="'padding-left: 5mm !important;'">
                    <div class="address"
                         style="border-bottom: 0.5pt solid #D9D9D9 !important; display: inline !important; font-size: 7pt !important; color: #959595 !important; padding-bottom: 1.5mm;">
                        <t t-if="main_company.name">
                            <span t-field="company.name"/>
                        </t>
                        <t t-if="main_company.street">
                            <span>|</span>
                            <span t-field="company.street"/>
                        </t>
                        <t t-if="main_company.street2">
                            <span>|</span>
                            <span t-field="company.street2"/>
                        </t>
                        <t t-if="main_company.zip">
                            <span>|</span>
                            <span t-field="company.zip"/>
                        </t>
                        <t t-if="main_company.city">
                            <span t-if="not company.zip">|</span>
                            <span t-field="company.city"/>
                        </t>
                        <t t-if="main_company.country_id and main_company.print_company">
                            <span>|</span>
                            <span t-field="company.country_id.name"/>
                        </t>
                    </div>
                    <div class="mt-3">
                        <div t-if="address">
                            <t t-if="o and 'partner_id' in o._fields">
                                <t t-set="partner_phone" t-value="o.partner_id.phone or o.partner_id.commercial_partner_id.phone"/>
                                <div t-if="partner_phone" t-out="partner_phone"/>
                            </t>
                            <t t-out="address"/>
                        </div>
                        <div t-else="fallback_address">
                            <t t-out="fallback_address"
                               t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        </div>
                    </div>
                </div>
                <div t-if="False" class="col-6"
                     t-attf-style="#{'margin-top: 33px !important;' if one_line_data else 'margin-top: 49px !important;'}">
                    <t t-out="din5008_document_information"/>
                </div>

            </div>
            <table class="mt-3 table-borderless" >
                <t t-if="din5008_address_block">
                    <t t-out="din5008_address_block"/>
                </t>
            </table>
        </xpath>
        <!--  Footer Part: 2026 design — full-bleed footer image with baked-in company data.
             Inline styles required (footer renders as separate html without the body style block). -->
        <xpath expr="//div[contains(@t-attf-class,'footer')]" position="attributes">
            <attribute name="style">padding: 0; margin: 0;</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'footer')]//div[hasclass('page_number')]" position="attributes">
            <attribute name="style">padding-right: 10mm; margin: 0; height: 4.9mm; line-height: 4.9mm; font-size: 7pt;</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'footer')]//div[hasclass('company_details')]" position="attributes">
            <attribute name="style">margin: 0; padding: 0;</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'footer')]//table" position="replace">
            <img src="/much_qweb_updater/static/img/footer_2026.png"
                 alt="partimus GmbH – Kontakt- und Bankdaten"
                 style="width: 210mm; height: 35.06mm; margin: 0; display: block; padding: 0;"/>
        </xpath>
    </template>
</odoo>
