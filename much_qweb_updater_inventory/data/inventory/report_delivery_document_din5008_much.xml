<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_din5008_much" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="primary"
               t-value="o.company_id.report_primary_color or '#ea5747'"/>
            <t t-set="secondary"
               t-value="o.company_id.report_secondary_color or '#ffffff'"/>

            <style type="text/css">
                .terms a{
                    color:<t t-out="primary"/>!important;
                }
                [name=stock_move_table] th,
                [name=stock_move_line_table] th,
                [name=stock_backorder_table] th {
                    color:<t t-out="secondary"/>!important;
                    background:<t t-out="primary"/>!important;
                }
            </style>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace"/>
        <xpath expr="//h2" position="after">
            <div class="table-container">
                <div name="div_incoming_address" class="table-cell left">
                </div>
            </div>
            <br/>
            <h5 style="font-weight: bold;">
                <span>Delivery Slip</span>
                <span t-field="o.name"/>
                <t t-if="o.order_title">
                    -
                    <span t-field="o.order_title"/>
                </t>
            </h5>
            <span t-if="o.report_header_text" t-out="o.env.user.get_evaluated_val(o, o.report_header_text)"/>
        </xpath>
        <xpath expr="//div[hasclass('mt32')]" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//th[@name='th_sm_product']" position="before">
            <th name="th_position" class="text-start ">
                Pos
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//tr[@t-foreach='lines']" position="before">
             <t t-set="count" t-value="0"/>
        </xpath>
        <xpath expr="//span[@t-field='move.product_id']/parent:: td" position="before">
            <t t-set="count" t-value="count+1"/>
            <td name="td_pos" class="text-start ">
                <span t-out="count"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="class" add="table-borderless" remove="table-sm" separator=" "/>
        </xpath>
        <xpath expr="//th[@name='th_sml_product']" position="before">
            <th name="th_position" class="text-start ">
                Pos
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="class" add="table-borderless" remove="table-sm" separator=" "/>
        </xpath>
        <xpath expr="//th[@name='th_sb_product']" position="before">
            <th name="th_position" class="text-start ">
                Pos
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_backorder_table']//tr[@t-as='bo_line']" position="before">
            <t t-set="count" t-value="0"/>
        </xpath>
        <xpath expr="//span[@t-field='bo_line.product_id']/parent:: td" position="before">
            <td name="td_pos" class="text-start ">
                <span t-out="count"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_backorder_table']//tbody//tr" position="inside">
             <t t-set="count" t-value="count+1"/>
        </xpath>
        <xpath expr="//table[@name='stock_backorder_table']//thead" position="attributes">
            <attribute name="class" add="table-borderless" remove="table-sm" separator=" "/>
        </xpath>
        <xpath expr="//h5" position="after">
            <t t-set="weight_move" t-value="any([rec.product_id.weight != 0  for rec in o.move_ids])"/>
            <t t-set="weight_move_line" t-value="any([rec.product_id.weight != 0  for rec in o.move_line_ids])"/>
        </xpath>
        <!-- set the value for hide the weight -->
        <!-- add the weight in header of stock move table -->
        <xpath expr="//th[@name='th_sm_product']" position="after">
            <th name="th_sm_origin_weight" t-if="o.company_id.print_weight and weight_move" class="text-start ">
                <span>Weight per piece</span>
            </th>
        </xpath>
        <xpath expr="//span[@t-field='move.product_id']/parent:: td" position="after">
            <td name="td_origin_weight" t-if="o.company_id.print_weight and weight_move" class="text-start ">
                <span t-field="move.product_id.weight"/>
            </td>
        </xpath>
        <!-- add the weight in header of stock move line table -->
        <xpath expr="//th[@name='th_sml_product']" position="after">
            <th name="th_sml_origin_weight" t-if="o.company_id.print_weight and weight_move_line" class="text-start ">
                <span>Weight per piece</span>
            </th>
        </xpath>
        <xpath expr="//tr[@t-foreach='package_move_lines']" position="before">
             <t t-set="count" t-value="1"/>
        </xpath>
        <xpath expr="//tr[@t-foreach='package_move_lines']" position="inside">
             <t t-set="count" t-value="count+1"/>
        </xpath>
        <xpath expr="//tr[@t-foreach='move_lines']" position="before">
             <t t-set="count" t-value="1"/>
        </xpath>
        <xpath expr="//tr[@t-foreach='move_lines']" position="inside">
             <t t-set="count" t-value="count+1"/>
        </xpath>
        <xpath expr="//tr[contains(@t-foreach, 'o.move') and contains(@t-foreach, 'move_line_ids')]" position="before">
             <t t-set="count" t-value="1"/>
        </xpath>
        <xpath expr="//tr[contains(@t-foreach, 'o.move') and contains(@t-foreach, 'move_line_ids')]" position="inside">
             <t t-set="count" t-value="count+1"/>
        </xpath>
        <!-- address changes start here -->
	    <xpath expr="//div[@name='outgoing_delivery_address']//div[1]" position="replace">
            <t t-set="delivery_address" t-value="o.move_ids[0].partner_id or o.partner_id"/>
            <div t-out="delivery_address"
                 t-options='{"widget": "contact", "fields": ["address","name"], "no_marker": True}'/>
        </xpath>

	    <xpath expr="//div[@t-field='o.picking_type_id.warehouse_id.partner_id']" position="replace">
		    <p t-if="o.picking_type_id.warehouse_id.partner_id.parent_id" class="m-0">
		        <t t-out="o.picking_type_id.warehouse_id.partner_id.parent_id.name"/>
	        </p>
	        <p class="m-0">
		        <t t-out="o.picking_type_id.warehouse_id.partner_id.name"/>
	        </p>
            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                 t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
        </xpath>
	    <xpath expr="//div[@t-field='partner.commercial_partner_id']" position="replace">
		    <p t-if="partner.parent_id" class="m-0">
		        <t t-out="partner.parent_id.name"/>
	        </p>
	        <p class="m-0">
		        <t t-out="partner.name"/>
	        </p>
            <div t-out="partner"
                 t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
        </xpath>

        <!-- added changes to hide v18 address blocks -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"/>
        </xpath>
            
        <xpath expr="//t[@t-set='address']" position="after">
            <t t-set="din5008_document_information">
                <div name="div_origin" t-if="o.origin">
                    Order: <span t-field="o.origin"/>
                </div>
                <div name="div_sched_date">
                    Shipping Date:
                    <span t-if="o.state == 'done'" t-field="o.date_done" t-options='{"format": "d.MM.yyyy"}'/>
                    <span t-else="" t-field="o.scheduled_date" t-options='{"format": "d.MM.yyyy"}'/>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[@t-set='din5008_address_block']" position="replace">
            <t t-set="din5008_address_block"/>
        </xpath>

        <!-- address changes ends here -->

        <xpath expr="//div[@name='div_incoming_address']" position="inside">
            <div t-if="o.company_id.show_document_address and o.document_address_id and o.sale_id and o.document_address_id != o.partner_id" 
                 name="div_document_address" class="table-cell left mt-2">
                <div>
                    <span class="fw-bold" t-translation="on">
                        Document Address:
                    </span>
                    <p t-if="o.document_address_id.parent_id" class="m-0">
                        <t t-out="o.document_address_id.parent_id.name"/>
                    </p>
                    <p class="m-0">
                        <t t-out="o.document_address_id.name"/>
                    </p>
                    <div t-field="o.document_address_id"
                         t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                </div>
            </div>
        </xpath>
    </template>
    
    <!-- Add the signature section at the end of the document -->
    <template id="report_delivery_document_din5008_signature_much" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-set='o']/.." position="inside">
            <div t-if="not o.signature" class="oe_structure"></div>
            <div t-else="" class="mt32 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div t-if="o.partner_id.name" class="offset-8 text-center">
                    <p t-field="o.partner_id.name">John Doe</p>
                </div>
            </div>
        </xpath>
    </template>
    
    <!-- add the weight in table rows -->
    <template id="stock_report_delivery_has_serial_move_line_din5008_much"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//span[@t-field='move_line.product_id']/parent:: td" position="before">
            <td name="td_pos" class="text-start ">
                <span t-out="count"/>
            </td>
        </xpath>
        <xpath expr="//span[@t-field='move_line.product_id']/parent:: td" position="after">
            <td name="td_origin_weight" t-if="o.company_id.print_weight and weight_move" class="text-start ">
                <span t-field="move_line.product_id.weight"/>
            </td>
        </xpath>
    </template>
     <!-- add the weight in table rows -->
    <template id="stock_report_delivery_aggregated_move_lines_din5008_much"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr[@t-foreach='aggregated_lines']" position="before">
            <t t-set="count" t-value="1"/>
        </xpath>
        <xpath expr="//tr[@t-foreach='aggregated_lines']//td[1]" position="before">
            <td name="td_pos" class="text-start ">
                <span t-out="count"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="before">
            <td class="text-start " t-if="o.company_id.print_weight and weight_move" name="mvl_td_origin_weight">
                <span t-out="aggregated_lines[line]['product'].weight"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
             <t t-set="count" t-value="count + 1"/>
        </xpath>
    </template>
</odoo>
