<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_inherit_updater_inventory" model="ir.ui.view">
        <field name="name">res.company.form.inherit.updater.inventory</field>
        <field name="model">res.company</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="much_qweb_updater.res_company_form_updater_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_company']" position="after">
                <field name="inventory_print_coo" invisible="1"/>
                <field name="inventory_print_hs_code" invisible="1"/>
                <field name="print_weight" invisible="1"/>
                <field name="description_delivery" invisible="1"/>
                <field name="show_document_address" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>