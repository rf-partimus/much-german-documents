<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_din5008_much" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="font" t-value="o.company_id.font or 'Lato'"/>
            <t t-set="primary"
               t-value="o.company_id.report_primary_color or '#ea5747'"/>
            <t t-set="secondary"
               t-value="o.company_id.report_secondary_color or '#ffffff'"/>

            <style type="text/css">
                .terms a{
                    color:<t t-out="primary"/>!important;
                }
                .o_main_table th {
                    color:<t t-out="secondary"/>!important;
                    background:<t t-out="primary"/>!important;
                }
            </style>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="after">
            <h5 style="font-weight: bold;">
                <span t-if="o.state == 'draft'">Request for Quotation</span>
                <span t-if="o.state in ['sent', 'to approve']">
                    Purchase Order
                </span>
                <span t-if="o.state in ['purchase', 'done']">
                    Purchase Order
                </span>
                <span t-if="o.state == 'cancel'">Cancelled Purchase Order
                </span>
                <span t-field="o.name"/>
                <t t-if="o.order_title">
                    -
                    <span t-field="o.order_title"/>
                </t>
            </h5>
             <span t-if="o.report_header_text" t-out="o.env.user.get_evaluated_val(o, o.report_header_text)"/>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_postion" class="text-start ">
                <strong>Pos</strong>
            </th>
        </xpath>
        <xpath expr="//t[@t-as='line']" position="before">
            <t t-set="count" t-value="0"/>
        </xpath>
        <xpath expr="//t[@t-as='line']//tr[1]" position="before">
            <t t-if="not line.display_type" t-set="count" t-value="count+1"/>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_pos" class="text-start ">
                <span t-out="count"/>
            </td>
        </xpath>
		<xpath expr="//t[@t-set='address']//div[@t-field='o.partner_id']" position="replace">
            <p t-if="o.partner_id.parent_id" class="m-0">
		        <t t-out="o.partner_id.parent_id.name"/>
	        </p>
	        <p class="m-0">
		        <t t-out="o.partner_id.name"/>
	        </p>
			<div t-field="o.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "vat"], "no_marker": True, "phone_icons": True}'/>
        </xpath>

        <xpath expr="//strong[following-sibling::span[@t-field='o.payment_term_id']]" position="attributes">
            <attribute name="t-if">o.payment_term_id</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.payment_term_id']" position="attributes">
            <attribute name="t-if">o.payment_term_id</attribute>
        </xpath>
    </template>

    <template id="report_purchaseorder_document_l10n_din5008_much" inherit_id="l10n_din5008_purchase.report_common_purchase_din5008_template_document_information">

        <xpath expr="//tr[@t-if='o.user_id']" position="after">
            <tr t-if="o.company_id.print_buyer_info and o.user_id.phone">
                <td>Phone:</td>
                <td>
                    <t t-out="o.user_id.phone"/>
                </td>
            </tr>

            <tr t-if="o.company_id.print_buyer_info and o.user_id.email">
                <td>Mail:</td>
                <td>
                    <t t-out="o.user_id.email"/>
                </td>
            </tr>
        </xpath>

        <xpath expr="//div[hasclass('information_block')]/table" position="attributes">
            <attribute name="class" add="table-borderless w-100" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('information_block')]/table" position="inside">
            <tr t-if="o.company_id.purchase_print_datev_identifier">
                <t t-if="'l10n_de_datev_supplier_identifier' in o.partner_id._fields">
                    <!-- This means that the datev module is installed -->
                    <t t-set="datev_supplier_identifier" t-value="o.partner_id.parent_id.l10n_de_datev_supplier_identifier or o.partner_id.l10n_de_datev_supplier_identifier"/>
                </t>
                <t t-else="">
                    <t t-set="datev_supplier_identifier" t-value="o.partner_id.parent_id.l10n_de_datev_identifier or o.partner_id.l10n_de_datev_identifier"/>
                </t>
                <t t-if="datev_supplier_identifier != 0">
                    <td>Your Supplier Reference:</td>
                    <td>
                        <t t-out="datev_supplier_identifier"/>
                    </td>
                </t>
            </tr>
        </xpath>
        <!-- used to show date_order only when date_approve is False mimicing odoo17 logic on _compute_l10n_din5008_template_data -->
        <xpath expr="//div[hasclass('information_block')]/table/tr[@t-if='o.date_order']" position="replace">
            <tr t-elif="o.date_order">
                <t>$0</t>
            </tr>
        </xpath>

    </template>

    <template id="l10n_din5008_purchase.report_common_purchase_din5008_template_address_block">
        <xpath expr="//tr[0]" position="replace">
            <tr t-if="o and o._name=='purchase.order'">
                <td class="shipping_address" t-if="o.dest_address_id">
                    <span class="fw-bold">Shipping Address:</span>
                    <address t-esc="o.dest_address_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </td>
                <td class="shipping_address" t-elif="'picking_type_id' in o._fields and o.picking_type_id.warehouse_id">
                    <span class="fw-bold">Shipping Address:</span>
                    <address t-esc="o.picking_type_id.warehouse_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </td>
            </tr>
        </xpath>
    </template>


</odoo>
