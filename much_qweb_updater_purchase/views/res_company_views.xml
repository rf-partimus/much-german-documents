<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_inherit_updater_purchase" model="ir.ui.view">
        <field name="name">res.company.form.inherit.updater.purchase</field>
        <field name="model">res.company</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="much_qweb_updater.res_company_form_updater_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_company']" position="after">
                <field name="print_buyer_info" invisible="1"/>
                <field name="purchase_print_datev_identifier" invisible="1"/>
                <field name="description_rfq" invisible="1"/>
                <field name="description_purchase" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>