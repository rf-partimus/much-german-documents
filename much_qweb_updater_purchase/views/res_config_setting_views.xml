<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_much_updater_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.much.updater.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="much_qweb_updater.res_config_settings_view_form_much_updater"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='much_qweb_updater']" position="inside">
                <block title="Much Qweb Updater Purchase" name="qweb_updater_purchase">
                    <setting id="setting_print_buyer_info">
                        <field name="print_buyer_info"/>
                    </setting>
                    <setting id="setting_purchase_print_datev_identifier">
                        <field name="purchase_print_datev_identifier"/>
                    </setting>
                    <setting id="setting_description_rfq">
                        <field name="description_rfq"/>
                    </setting>
                    <setting id="setting_description_purchase">
                        <field name="description_purchase"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
