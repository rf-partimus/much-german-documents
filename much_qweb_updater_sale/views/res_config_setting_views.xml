<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_much_updater_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.much.updater.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="much_qweb_updater.res_config_settings_view_form_much_updater"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='much_qweb_updater']" position="inside">
                <block title="Much Qweb Updater Sale" name="qweb_updater_sale">
                    <setting id="setting_so_print_sale_person">
                        <field name="so_print_sale_person"/>
                    </setting>
                    <setting id="setting_so_print_datev_identifier_customer">
                        <field name="so_print_datev_identifier_customer"/>
                    </setting>
                    <setting id="setting_taxes_on_line">
                        <field name="taxes_on_line"/>
                    </setting>
                    <setting id="setting_so_print_invoice_shipping_address" help="Enable to always print invoice and delivery addresses on reports when delivery address match the customer address">
                        <field name="so_print_invoice_shipping_address"/>
                    </setting>
                    <setting id="setting_description_quotation">
                        <field name="description_quotation"/>
                    </setting>
                    <setting id="setting_description_order">
                        <field name="description_order"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
