<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_date_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <label for="delivery_start_date" string="Delivery time frame"/>
                <div class="o_row">
                    <field name="delivery_start_date"
                           readonly="state == 'posted'" class="mr-1"/>
                    to
                    <field name="delivery_end_date"
                           readonly="state == 'posted'" class="ml-1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
