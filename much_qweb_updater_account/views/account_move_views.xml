<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_much_din5008" model="ir.ui.view">
        <field name="name">account.move.form.much.din5008</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="order_title"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <label for="report_header_text"/>
                <field name="report_header_text"
                       placeholder="Add a description before table..." nolabel="1"
                       height="50"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="print_time_frame" invisible="1"/>
                <label for="delivery_start_date" string="Delivery time frame"
                       invisible="not print_time_frame or move_type not in ['out_invoice', 'in_invoice']"/>
                <div class="o_row"
                     invisible="not print_time_frame or move_type not in ['out_invoice', 'in_invoice']">
                    <field name="delivery_start_date"
                           readonly="state == 'posted'"
                           class="mr-1 oe_inline"/>
                    to
                    <field name="delivery_end_date"
                           readonly="state == 'posted'"
                           class="ml-1 oe_inline"/>
                </div>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not delivery_date_error_message">
                    <field name="delivery_date_error_message" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="after">
                <field name="delivery_start_date"/>
                <field name="delivery_end_date"/>
            </xpath>
        </field>
    </record>
</odoo>
