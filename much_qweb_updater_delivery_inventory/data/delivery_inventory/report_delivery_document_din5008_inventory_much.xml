<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- add the COO , HS code, weight in table rows -->
    <template id="stock_report_delivery_has_serial_move_line_din5008_much_delivery"
              inherit_id="much_qweb_updater_inventory.stock_report_delivery_has_serial_move_line_din5008_much">
        <xpath expr="//span[@t-field='move_line.product_id.weight']/parent:: td" position="before">
            <td name="td_origin_country" t-if="o.company_id.inventory_print_coo and coo_move" class="text-start ">
                <span t-field="move_line.product_id.country_of_origin.code"/>
            </td>
            <td name="td_origin_hs_code" t-if="o.company_id.inventory_print_hs_code and hs_code_move" class="text-start ">
                <span t-field="move_line.product_id.hs_code"/>
            </td>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines_din5008_much_delivery"
              inherit_id="much_qweb_updater_inventory.stock_report_delivery_aggregated_move_lines_din5008_much">
        <xpath expr="//td[@name='mvl_td_origin_weight']" position="before">
            <td class="text-start " t-if="o.company_id.inventory_print_coo and coo_move" name="mvl_td_origin_country">
                <span t-out="aggregated_lines[line]['product'].country_of_origin.code"/>
            </td>
            <td class="text-start " t-if="o.company_id.inventory_print_hs_code and hs_code_move" name="mvl_td_origin_hs_code">
                <span t-out="aggregated_lines[line]['product'].hs_code"/>
            </td>
        </xpath>
    </template>

    <record id="stock_delivery.report_delivery_document2" model="ir.ui.view">
        <field name="priority">17</field>
    </record>

    <template id="report_delivery_document2_inherit_much" inherit_id="stock_delivery.report_delivery_document2">
        <xpath expr="//div[@t-field='o.carrier_id']/.." position="replace">
            <div t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id">
                Carrier:
                <span t-field="o.carrier_id"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='o.shipping_weight']" position="replace">
            <div t-if="o.shipping_weight">
                Total Weight: 
                <span t-field="o.shipping_weight"/>
                <span t-field="o.weight_uom_name"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='o.carrier_tracking_ref']" position="replace">
            <div t-if="o.carrier_tracking_ref">
                Tracking Number:
                <span t-field="o.carrier_tracking_ref"/>
            </div>
        </xpath>
        <!-- hide the base th and td -->
        <xpath expr="//table[@name='stock_move_line_table']//th[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//th[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//td[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>
    <template id="stock_report_delivery_has_serial_move_line_inherit_much" inherit_id="stock_delivery.stock_report_delivery_has_serial_move_line_inherit_delivery">
        <xpath expr="//td[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines_inherit_much" inherit_id="stock_delivery.stock_report_delivery_aggregated_move_lines_inherit_delivery">
        <xpath expr="//td[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>
</odoo>
