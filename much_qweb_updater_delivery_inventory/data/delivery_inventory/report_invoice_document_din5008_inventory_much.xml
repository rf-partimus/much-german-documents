<?xml version="1.0"?>
<odoo>
    <template id="report_invoice_document_din5008_delivery_inventory_much" inherit_id="much_qweb_updater_inventory.report_delivery_document_din5008_much">
        <xpath expr="//h5" position="after">
            <t t-set="hs_code_move" t-value="any([rec.product_id.hs_code for rec in o.move_ids])"/>
            <t t-set="coo_move" t-value="any([rec.product_id.country_of_origin.code for rec in o.move_ids])"/>
            <t t-set="hs_code_move_line" t-value="any([rec.product_id.hs_code for rec in o.move_line_ids])"/>
            <t t-set="coo_move_line" t-value="any([rec.product_id.country_of_origin.code for rec in o.move_line_ids])"/>
        </xpath>
        <!-- set the value for hide the COO, HS code -->
        <!-- add the COO , HS code  in header of stock move table -->
        <xpath expr="//th[@name='th_sm_origin_weight']" position="before">
            <th name="th_sm_origin_country" t-if="o.company_id.inventory_print_coo and coo_move" class="text-start ">
                <span>Country of Origin</span>
            </th>
            <th name="th_sm_origin_hs_code" t-if="o.company_id.inventory_print_hs_code and hs_code_move" class="text-start ">
                <span>Custom Tarif Number</span>
            </th>
        </xpath>
        <xpath expr="//span[@t-field='move.product_id.weight']/parent:: td" position="before">
            <td name="td_origin_country" t-if="o.company_id.inventory_print_coo and coo_move" class="text-start ">
                <span t-field="move.product_id.country_of_origin.code"/>
            </td>
            <td name="td_origin_hs_code" t-if="o.company_id.inventory_print_hs_code and hs_code_move" class="text-start ">
                <span t-field="move.product_id.hs_code"/>
            </td>
        </xpath>
        <!-- add the COO , HS code, weight in header of stock move line table -->
        <xpath expr="//th[@name='th_sml_origin_weight']" position="before">
            <th name="th_sml_origin_country" t-if="o.company_id.inventory_print_coo and coo_move_line" class="text-start ">
                <span>Country of Origin</span>
            </th>
            <th name="th_sml_origin_hs_code" t-if="o.company_id.inventory_print_hs_code and hs_code_move_line" class="text-start ">
                <span>Custom Tarif Number</span>
            </th>
        </xpath>
    </template>
</odoo>
